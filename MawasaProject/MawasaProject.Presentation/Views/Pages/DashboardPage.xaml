<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MawasaProject.Presentation.Views.Pages.DashboardPage"
             Title="Dashboard"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E9EDF3">
    <ContentPage.Resources>
        <Color x:Key="SidebarBlue">#1A9EDB</Color>
        <Color x:Key="SidebarBlueDark">#168DC6</Color>
        <Color x:Key="SidebarItemActive">#22ABE8</Color>
        <Color x:Key="SidebarText">#E8F6FF</Color>
        <Color x:Key="SurfaceCard">#FFFFFF</Color>
        <Color x:Key="TextMain">#1F2A37</Color>
        <Color x:Key="TextMuted">#6F8093</Color>
        <Color x:Key="MetricBlue">#1C9FDA</Color>
        <Color x:Key="MetricBlueDark">#148BC2</Color>
    </ContentPage.Resources>

    <Grid><!-- single column; sidebar is in AppShell FlyoutContent -->

        <ScrollView>
            <VerticalStackLayout Padding="16,14,16,24" Spacing="14">
                <!-- ═══ TOP BAR: Branding + User ═══ -->
                <Border BackgroundColor="#F8FBFF" Stroke="#D6DEE7" StrokeThickness="1" Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Border WidthRequest="34" HeightRequest="34" BackgroundColor="#2FA4DC" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label Text="MW" TextColor="White" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="MANAMBULAN WATERWORKS AND SANITATION INC." FontAttributes="Bold"
                                       FontSize="15" TextColor="{StaticResource TextMain}" />
                                <Label Text="Admin Portal" FontSize="12" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center"
                                               IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}">
                            <Border WidthRequest="30" HeightRequest="30" BackgroundColor="#E9EFF8" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Label Text="AD" FontSize="11" FontAttributes="Bold" TextColor="#506175"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding CurrentUsername, StringFormat='Hi, {0}'}"
                                           FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextMain}" />
                                <Label Text="{Binding CurrentRoleDisplay}" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- ═══ HERO SECTION: Primary KPI ═══ -->
                <Border BackgroundColor="#0D4F8B" StrokeThickness="0" Padding="20,18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="BILLED REVENUE" FontSize="11" FontAttributes="Bold" TextColor="#8FCEF5" />
                            <Label Text="Total invoices generated this period" FontSize="13" TextColor="#C3E5F9" />
                            <Label Text="{Binding TotalRevenue, StringFormat='P{0:N2}'}" FontSize="38" FontAttributes="Bold" TextColor="White" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="4" HorizontalOptions="End">
                            <Label Text="COLLECTION RATE" FontSize="9" FontAttributes="Bold" TextColor="#8FCEF5" HorizontalTextAlignment="End" />
                            <Label Text="{Binding CollectionRate, StringFormat='{0:P1}'}" FontSize="28" FontAttributes="Bold" TextColor="#5EDBA5" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ═══ SECONDARY KPI ROW: 3 Cards ═══ -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border BackgroundColor="{StaticResource MetricBlue}" StrokeThickness="0" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="COLLECTIONS" FontSize="10" FontAttributes="Bold" TextColor="#D7F1FF" />
                            <Label Text="Posted receipts" FontSize="12" TextColor="#C3E5F9" />
                            <Label Text="{Binding OutstandingBalance, StringFormat='P{0:N2}'}" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource MetricBlue}" StrokeThickness="0" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="NEW REGISTRATIONS" FontSize="10" FontAttributes="Bold" TextColor="#D7F1FF" />
                            <Label Text="Customers added" FontSize="12" TextColor="#C3E5F9" />
                            <Label Text="{Binding TotalCustomers}" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="#14739B" StrokeThickness="0" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="AVG MONTHLY" FontSize="10" FontAttributes="Bold" TextColor="#D7F1FF" />
                            <Label Text="Monthly average" FontSize="12" TextColor="#C3E5F9" />
                            <Label Text="{Binding AverageMonthlyRevenue, StringFormat='P{0:N2}'}" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ═══ FILTER + SYNC INDICATOR ═══ -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label TextColor="#3E536A" FontSize="12">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Synced with Insights filter - " />
                                <Span Text="{Binding StartDateUtc, StringFormat='{0:MMM d, yyyy}'}" FontAttributes="Bold" />
                                <Span Text=" - " />
                                <Span Text="{Binding EndDateUtc, StringFormat='{0:MMM d, yyyy}'}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="LIVE" FontSize="11" TextColor="#6C7D90" VerticalTextAlignment="Center" />
                </Grid>

                <!-- ═══ INSIGHTS: Revenue Chart ═══ -->
                <Border BackgroundColor="{StaticResource SurfaceCard}" Stroke="#D9E2EC" StrokeThickness="1" Padding="14,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                            <Label Text="Insights" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" HorizontalOptions="End" Spacing="8" Margin="0,8,0,0">
                                <DatePicker Date="{Binding StartDateUtc}" />
                                <DatePicker Date="{Binding EndDateUtc}" />
                                <Button Text="Apply" Command="{Binding RefreshCommand}" FontSize="12" Padding="12,8" BackgroundColor="{StaticResource MetricBlueDark}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <WebView x:Name="RevenueChartView"
                                 HeightRequest="260"
                                 HorizontalOptions="Fill"
                                 Source="revenue_chart.html"
                                 Navigated="OnChartNavigated" />
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ OPERATIONAL PANEL: Tasks + Analytics ═══ -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                    <!-- Admin Tasks -->
                    <Border Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                            BackgroundColor="{StaticResource SurfaceCard}" Stroke="#D9E2EC" StrokeThickness="1" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Admin Tasks" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border BackgroundColor="#FFF8E8" Stroke="#F2CF7A" StrokeThickness="1" Padding="10,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <VerticalStackLayout>
                                        <Label Text="PENDING BILLS" FontSize="10" FontAttributes="Bold" TextColor="#B9871B" />
                                        <Label Text="{Binding PendingBills}" FontSize="28" FontAttributes="Bold" TextColor="#8B5D00" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#FFF1F0" Stroke="#FFC1C0" StrokeThickness="1" Padding="10,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <VerticalStackLayout>
                                        <Label Text="OVERDUE BILLS" FontSize="10" FontAttributes="Bold" TextColor="#D32F2F" />
                                        <Label Text="{Binding OverdueBills}" FontSize="28" FontAttributes="Bold" TextColor="#B71C1C" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Label Text="Prioritize follow-ups for overdue accounts to improve collection rate." FontSize="13" TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Connection Analytics -->
                    <Border Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                            Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                            BackgroundColor="{StaticResource SurfaceCard}" Stroke="#D9E2EC" StrokeThickness="1" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Connection Analytics" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                            <Grid HorizontalOptions="Center">
                                <WebView x:Name="AnalyticsChartView"
                                         WidthRequest="180" HeightRequest="180"
                                         Source="analytics_chart.html"
                                         Navigated="OnAnalyticsChartNavigated" />
                            </Grid>
                            <Label Text="{Binding TotalCustomers, StringFormat='Residential: {0}'}" FontSize="13" TextColor="#41556D" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#6B7C8F" />
                <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="#BC1F1F" IsVisible="{Binding HasErrors}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
